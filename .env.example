# =====================================================
# OYUGIS LE GRAND HOTEL — Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control
# =====================================================

# ── DATABASE ─────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/oyugis_hotel"

# ── NEXTAUTH ──────────────────────────────────────────
NEXTAUTH_SECRET="generate-a-random-secret-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# ── EMAIL (Nodemailer) ────────────────────────────────
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USER="your-gmail@gmail.com"
EMAIL_PASSWORD="your-gmail-app-password"
# The hotel's receiving email address
HOTEL_EMAIL="info@oyugislegrand.co.ke"

# ── M-PESA (Safaricom Daraja API) ────────────────────
MPESA_CONSUMER_KEY="your-consumer-key"
MPESA_CONSUMER_SECRET="your-consumer-secret"
MPESA_PASSKEY="your-lipa-na-mpesa-online-passkey"
MPESA_SHORTCODE="your-business-shortcode"
# Full URL where M-Pesa sends payment callbacks
MPESA_CALLBACK_URL="https://yourdomain.co.ke/api/payments/mpesa/callback"
# sandbox | production
MPESA_ENVIRONMENT="sandbox"

# ── STRIPE ────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_your-stripe-secret-key"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your-stripe-publishable-key"
STRIPE_WEBHOOK_SECRET="whsec_your-webhook-secret"

# ── GOOGLE MAPS ───────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# ── WHATSAPP ──────────────────────────────────────────
# Hotel WhatsApp number in international format (no +, no spaces)
NEXT_PUBLIC_WHATSAPP_NUMBER="254700000000"

# ── SITE ──────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://oyugislegrand.co.ke"
NEXT_PUBLIC_HOTEL_NAME="Oyugis Le Grand Hotel"
NEXT_PUBLIC_HOTEL_PHONE="+254 700 000 000"
NEXT_PUBLIC_HOTEL_EMAIL="info@oyugislegrand.co.ke"
NEXT_PUBLIC_HOTEL_ADDRESS="Oyugis Town, Homa Bay County, Kenya"
