# ─── Dependencies ────────────────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# ─── Next.js build output ────────────────────────────────────────────────────
/.next/
/out/

# ─── Production build ────────────────────────────────────────────────────────
/build

# ─── Environment files — NEVER commit these ──────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# .env.example is safe to commit (it has no real secrets)

# ─── Data / database files — contain real user data and passwords ─────────────
/data/

# ─── Prisma generated files ──────────────────────────────────────────────────
/prisma/dev.db
/prisma/dev.db-journal

# ─── Debug logs ──────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ─── OS / editor files ───────────────────────────────────────────────────────
.DS_Store
*.pem
Thumbs.db
.vscode/
.idea/

# ─── TypeScript ──────────────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts
